// jpm-format: the `jpm format` extension. Install with `jpm add -g github:java-package-manager/jpm-format`.
// Building it needs jpm 0.14.0 or newer, which builds an extension with its own "java" (21), so "javacArgs" can open javac.
{
  "name": "jpm-format",
  "group": "dev.jpm",
  "version": "0.7.2",
  "license": "MIT",
  "description": "Format and lint jpm projects: an IntelliJ-style formatter, built-in inspections and custom rules",
  "url": "https://github.com/java-package-manager/jpm-format",
  "java": "21",
  "main": "dev.jpm.format.Main",
  // what IDEs show for `jpm format` (jpm's extensions/list), and the check `jpm check` runs
  "extension": {
    "description": "Format and lint Java code",
    "commands": {
      "format": {
        "description": "Format every file and apply every safe fix",
        "options": {
          "--check": { "description": "Change nothing; report formatting differences and lint findings, and exit 1 if there are any" },
          "--stdin": { "argument": "path", "description": "Format standard input as if it were <path>; print the result" },
          "--reporter": { "argument": "name", "description": "pretty (default), json, sarif or github" },
          "--debug": { "description": "Run every formatter twice and report those whose output changes" },
          "--no-cache": { "description": "Ignore and do not write .cache/format/" },
          "--threads": { "argument": "n", "description": "Files processed in parallel (default: one per CPU)" }
        }
      },
      "format lsp": { "description": "Run the language server (stdio)" },
      "format test": { "description": "Run the rule tests in rules/test/", "options": { "--update": { "description": "Rewrite the snapshots" } } },
      "format rules": { "description": "List the rules and how they are configured" }
    },
    "checks": { "format": { "description": "Every file is formatted and has no lint findings", "run": ["--check"] } }
  },
  // jpm generates this class with NAME and VERSION from this file; Main.VERSION reads it
  "defineClass": "dev.jpm.format.BuildConfig",
  // jpm's client, dev.jpm:jpm-api, is published here
  "repositories": ["https://repo.thenextlvl.net/releases"],
  "runtime": {
    "dev.jpm:jpm-api": "0.17.0"
  },
  "test": {
    "org.junit.jupiter:junit-jupiter": "6.1.3"
  },
  "extensions": {
    // a release is a tag, which `jpm add` installs from: `jpm changeset publish` only tags
    "changeset": { "tagOnly": true },
    "format": {
      // decisions go into docs/adr and explanations into Javadoc (ADR 0001)
      "linter": { "rules": { "style": { "NonJavadocComment": "error" } } },
      // generated: by jpm-changeset and by `UPDATE_DOCS=1 jpm test`
      "ignore": ["CHANGELOG.md", "docs/inspections.md"]
    },
    "github:java-package-manager/jpm-changeset": "^0.3.0"
  }
}
