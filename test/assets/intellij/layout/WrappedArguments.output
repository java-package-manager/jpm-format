class WrappedArguments {
    void a() {
        foo(a, bar(
                x,
                y
        ));
        foo(bar(
                x,
                y
        ), a);
        foo(a, b, bar(
                x
        ));
        foo(a, () -> {
            x();
        });
        foo(a, new Object() {
            int f;
        });
        foo(a, """
                text
                """);
        foo(a, bar(x)
                .baz());
    }

    void b() {
        foo(a, bar(
                        x,
                        y
                )
        );
        foo(bar(
                        x
                ), a
        );
        foo(a, () -> {
                    x();
                }
        );
        foo(a, """
                text
                """
        );
        foo(a, bar(x)
                .baz()
        );
        foo(a, () -> {
                    x();
                },
                b);
        foo(
                a, bar(
                        x
                )
        );
    }

    void c() {
        foo(bar(x)
                .baz()
        );
        foo(bar(x)
                        .baz(),
                b);
        foo(a, bar(x)
                        .baz(),
                b);
        foo("""
                text
                """
        );
        foo(a, """
                        text
                        """,
                b);
        foo("""
                        text
                        """,
                b);
        foo(x
                        + y,
                b);
        foo(a, x
                        + y,
                b);
    }

    void wrappedChain() {
        return command.then(Commands.argument("options", new CommandOptionsArgument(
                        Set.of("--confirm", "--schedule")
                )).executes(this))
                .executes(this::confirmationNeeded);
        return command.then(Commands.argument("options", foo(
                        Set.of("--confirm", "--schedule")
                )))
                .executes(this::confirmationNeeded);
        return command.then(foo(
                        Set.of("--confirm", "--schedule")
                ))
                .executes(this::confirmationNeeded);
        return command.then(
                        Set.of("--confirm", "--schedule")
                )
                .executes(this::confirmationNeeded);
        return command.then(foo(
                        Set.of("--confirm", "--schedule")))
                .executes(this::confirmationNeeded);
        return command.then(a, foo(
                        Set.of("--confirm", "--schedule")
                ))
                .executes(this::confirmationNeeded);
        return command.then(foo(x -> {
                    bar();
                }))
                .executes(this::confirmationNeeded);
        return command.then(foo(x,
                        y
                ))
                .executes(this::confirmationNeeded);
        return a.b().then(foo(
                        Set.of("--confirm", "--schedule")
                ))
                .executes(this::confirmationNeeded);
        command.then(foo(
                        Set.of("--confirm", "--schedule")
                ))
                .executes(this::confirmationNeeded);
        x = command.then(foo(
                        Set.of("--confirm", "--schedule")
                ))
                .executes(this::confirmationNeeded);
    }
}
