package demo;

public class CaseBlocks {
    int f(int x) {
        switch (x) {
            case 1: {
                int a = 1;
                return a;
            }
            case 2: {
                int b = 2;
                return b;
            }
            case 3: {
                g();
            }
            break;
            case 4: {
                g();
            }
            break;
            case 5:
                g();
            {
                g();
            }
            break;
            case 6, 7: {
                return 6;
            }
            case 8: {
                switch (x) {
                    case 9: {
                        return 9;
                    }
                    default:
                        return 0;
                }
            }
            case 10: {
                return 10;
            }
            case 11: // a comment
            {
                return 11;
            }
            default: {
                return -1;
            }
        }
    }

    void g() {
    }
}
